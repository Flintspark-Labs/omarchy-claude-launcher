#!/bin/bash
# Regenerates ~/.config/hypr/claude-launcher.lua from the profiles file, so each
# profile's "key" becomes a Hyprland shortcut. Re-run after editing the profiles.
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CONFIG="${CLAUDE_LAUNCHER_CONFIG:-$HOME/.config/omarchy/claude-launcher.json}"
OUT="$HOME/.config/hypr/claude-launcher.lua"
BINDINGS="$HOME/.config/hypr/bindings.lua"

# CLI shortcuts: claude-fable, claude-opus, claude-sonnet, claude-haiku
mkdir -p "$HOME/.local/bin"
for m in fable opus sonnet haiku; do ln -sf "$DIR/claude-launch" "$HOME/.local/bin/claude-$m"; done

[[ -f $CONFIG ]] || { mkdir -p "$(dirname "$CONFIG")"; cp "$DIR/../examples/claude-launcher.json" "$CONFIG"; echo "created $CONFIG"; }

# First run: seed the recent-folders list from Claude Code's own history.
recent="${XDG_STATE_HOME:-$HOME/.local/state}/claude-launcher/recent"
if [[ ! -s $recent && -f $HOME/.claude/history.jsonl ]]; then
  mkdir -p "$(dirname "$recent")"
  jq -r '.project // empty' "$HOME/.claude/history.jsonl" | tac | awk '!seen[$0]++' |
    while read -r d; do [[ -d $d ]] && echo "$d"; done | head -5 > "$recent"
fi

{
  echo "-- Generated by claude-launcher-sync from $CONFIG. Do not edit."
  jq -r --arg bin "$DIR/claude-launch" '
    (select(.chooserKey) | "o.bind(\(.chooserKey|@json), \"Claude launcher\", \"omarchy-shell shell toggle flintspark.claude-launcher\")"),
    (.profiles[] | select(.key) |
      "o.bind(\(.key|@json), \("Claude: " + .name|@json), \("\($bin) --profile \(.name|@sh)"|@json))")
  ' "$CONFIG"
} > "$OUT"

grep -q 'hypr.claude-launcher' "$BINDINGS" || printf '\nrequire("hypr.claude-launcher")\n' >> "$BINDINGS"
hyprctl reload >/dev/null && hyprctl configerrors
