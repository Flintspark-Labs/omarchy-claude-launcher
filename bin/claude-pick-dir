#!/bin/bash
# Runs in a TUI terminal: pick any folder under $HOME (or type a path), then start claude there.
# Usage: claude-pick-dir <model> <effort>
dir=$(find "$HOME" -maxdepth 5 \( -name '.*' -o -name node_modules -o -name __pycache__ -o -name dist -o -name target \) -prune -o -type d -print 2>/dev/null |
  fzf --prompt="Claude folder (type a path + enter for any folder) > " --print-query | tail -1) || true
dir="${dir/#\~/$HOME}"
[[ -d $dir ]] || exit 0
exec "$(dirname "$(readlink -f "$0")")/claude-launch" --here --dir "$dir" "$@"
